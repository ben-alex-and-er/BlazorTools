@typeparam TItem

<CascadingValue Value="this">
	<table class="bt-table">
		<thead>
			<tr>
				@foreach (var column in _columns)
				{
					<th>
						<div class="header">
							<span>@column.Title</span>
						</div>
					</th>
				}
			</tr>
		</thead>

		<tbody>
			@if (Items is not null)
			{
				@foreach (var item in Items)
				{
					<tr @key="item">
						@foreach (var column in _columns)
						{
							<td>
								@column.RenderCell(item)
							</td>
						}
					</tr>
				}
			}
		</tbody>
	</table>

	@ChildContent
</CascadingValue>