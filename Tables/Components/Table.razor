@typeparam TItem

@inherits TableBase<TItem>

@using Tables.Components.Internal


<BaseTable TItem="TItem" Items="newItems" OnSort="OnSort" OnFilter="OnFilter">
	<ChildContent>
		@ChildContent
	</ChildContent>
</BaseTable>

@if (TotalPages > 1)
{
	<div class="bt-pagination">
		<button @onclick="async () => await SetPage(Page - 1)" disabled="@(Page <= 1)">
			&#60;
		</button>

		<span>Page @Page of @TotalPages</span>

		<button @onclick="async () => await SetPage(Page + 1)" disabled="@(Page >= TotalPages)">
			&#62;
		</button>

		<span>(@TotalCount items)</span>
	</div>
}